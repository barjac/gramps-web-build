#!/bin/bash

# Install the Gramps addons that Gramps Web expects (as upstream's Docker image does)
# into the service's Gramps user plugin dir, <basedir>/data/gramps/grampsXY/plugins.
#  - FilterRules: extra filter rules, e.g. DegreesOfSeparation (Relationship Graph)
#  - JSON:        JSON import/export format
# Existing copies are replaced by the current release from the addons repo.
# Usage (as root): mk-addons <basedir>

((UID)) && { echo "ERROR: $0 must be run as root"; exit 1; }
basedir=$1
[[ -n $basedir ]] || { echo "Usage: $0 <basedir>"; exit 1; }
umask 022

addons="FilterRules JSON"

# Addons are built per Gramps major.minor, e.g. gramps60
gv=$("$basedir/venv/bin/python" -c \
    'from gramps.version import VERSION_TUPLE as v; print("gramps%d%d" % v[:2])') \
    || { echo "ERROR: cannot find the Gramps version"; exit 1; }

# GRAMPSHOME=<basedir>/data in the service, so Gramps looks here
data=$basedir/data
plugins=$data/gramps/$gv/plugins
[[ -d $data ]] || { echo "ERROR: $data not found"; exit 1; }

# Parents belong to the service user (Gramps may write there); the plugin code is root's
install -d -o gramps-web -g gramps-web -m 0750 "$data/gramps" "$data/gramps/$gv" || exit 1
install -d -m 0755 "$plugins" || exit 1

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
for addon in $addons; do
    url=https://github.com/gramps-project/addons/raw/master/$gv/download/$addon.addon.tgz
    echo "Downloading Gramps addon $addon ($gv)"
    mkdir "$tmp/$addon" || exit 1
    curl -sfL "$url" | tar xz --no-same-owner -C "$tmp/$addon" \
        || { echo "ERROR: download/extract of $url failed"; exit 1; }
    [[ -d $tmp/$addon/$addon ]] || { echo "ERROR: unexpected layout in $addon.addon.tgz"; exit 1; }
    chmod -R u=rwX,go=rX "$tmp/$addon/$addon"
    rm -rf "${plugins:?}/$addon"
    mv "$tmp/$addon/$addon" "$plugins/" || { echo "ERROR: installing $plugins/$addon failed"; exit 1; }
done

echo "Gramps addons installed in $plugins: $addons"
